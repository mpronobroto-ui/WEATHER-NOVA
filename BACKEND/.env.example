# Copy this file to ".env" (same folder as main.py) and fill in what you
# have. main.py loads this automatically on startup — no need to set
# environment variables by hand in every terminal session.
# Every section below is OPTIONAL — the app runs fully without any of them,
# just with fewer live integrations turned on.

# ---- LLM query understanding + phrasing (pick ONE) -------------------------
GEMINI_API_KEY=paste_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=sk-...
# OLLAMA_URL=http://localhost:11434

# ---- WIS2.0 live MQTT ingestion (Global Broker, no key needed) -------------
WIS2_ENABLE=true
WIS2_BROKER_HOST=globalbroker.meteo.fr
WIS2_BROKER_PORT=8883
WIS2_USERNAME=everyone
WIS2_PASSWORD=everyone
WIS2_TOPIC=cache/a/wis2/+/data/core/weather/prediction/forecast/cyclone_tracks

# ---- MySQL district-boundary lookup (GIS layer) ----------------------------
# Requires MySQL 8.0+ or MariaDB 10.5+ for spatial functions.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password
MYSQL_DB=weathergpt

# ---- SMS early-warning dissemination (Twilio) ------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15551234567
ALERT_DISPATCH_MIN_LEVEL=orange
ALERT_DISPATCH_INTERVAL_SECONDS=3600
# Radius (km) from a subscriber's saved point within which an active
# cyclone triggers an SMS. Default 100km.
CYCLONE_ALERT_RADIUS_KM=100

# ---- Login (phone + OTP) ----------------------------------------------------
# Signs session tokens issued after OTP verification. CHANGE THIS in any
# real deployment — leaving the default lets anyone forge a session token.
SESSION_SECRET=change-me-to-a-long-random-string
OTP_TTL_SECONDS=300
SESSION_TTL_SECONDS=2592000
